# CG Performance | environment variables
#
# Copy to .env.local for local development with `vercel dev`.
# In production these are set in the Vercel dashboard under
# Project Settings, Environment Variables.
#
# NEVER commit real values. .env and .env.local are gitignored.

# --- Site -------------------------------------------------------------------
# Canonical site URL. Used for Stripe success and cancel URLs and for the
# same origin check on both functions.
SITE_URL=https://cgperformance.fit

# --- Stripe -----------------------------------------------------------------
# Secret key. Use the test key (sk_test_...) until testing is complete.
STRIPE_SECRET_KEY=

# Recurring monthly Price IDs (price_...), created in the Stripe Dashboard.
# See STRIPE_SETUP.md.
STRIPE_PRICE_PT_4_MONTHLY=
STRIPE_PRICE_PT_8_MONTHLY=
STRIPE_PRICE_PT_12_MONTHLY=
STRIPE_PRICE_ONLINE_MONTHLY=
STRIPE_PRICE_VIRTUAL_4_MONTHLY=
STRIPE_PRICE_VIRTUAL_8_MONTHLY=
STRIPE_PRICE_VIRTUAL_12_MONTHLY=

# One time Price IDs (price_...)
STRIPE_PRICE_PT_3_PACK=
STRIPE_PRICE_PT_10_PACK=
STRIPE_PRICE_MOVEMENT_ANALYSIS=

# --- Enquiry form email -----------------------------------------------------
# Resend API key (re_...), from https://resend.com
RESEND_API_KEY=

# Where enquiries are delivered. Defaults to chrisgkoufas.performance@gmail.com
ENQUIRY_TO=

# Sender shown on the enquiry email. While the domain is not verified in
# Resend, leave this blank so the shared test sender is used.
# Once cgperformance.fit is verified, set it to something like:
#   CG Performance Website <enquiries@cgperformance.fit>
ENQUIRY_FROM=

# --- Notes ------------------------------------------------------------------
# Every service is bought through api/create-checkout.js, so there are no
# Stripe Payment Links to manage and no Price ID is ever sent to the browser.
#
# Promotion codes and coupon IDs are never stored in this file or anywhere in
# the repository. They exist only in the Stripe Dashboard.
